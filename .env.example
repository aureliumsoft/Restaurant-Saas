# =============================================================================
# Restaurant SaaS — example environment.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# Postgres (Prisma) — connection URL with sslmode=require for hosted DBs.
# Use direct host (db.prisma.io) for migrations, not pooled.db.prisma.io.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# If `npx prisma migrate deploy` times out with P1002 advisory lock, add:
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=true
# Or use: npm run db:migrate (handles this automatically)

# NextAuth.js
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — used by NextAuth Google sign-in (login).
# Reporting credentials can also be set in Admin → SEO (preferred for GSC/GA4 metrics).
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
VERCEL_URL="localhost:3000"

# Optional env overrides for admin dashboard GSC + GA4 (if Admin → SEO fields are empty):
# GOOGLE_REPORTING_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_REPORTING_REFRESH_TOKEN=

# JazzCash hosted checkout callback (required for local dev — JazzCash rejects localhost).
# Must match the Return URL registered in the JazzCash merchant portal exactly.
# JAZZCASH_RETURN_URL="https://foodluk.com/api/jazzcash/return"

# POS terminal companion service (Stripe Terminal / local register integrations).
NEXT_PUBLIC_POS_TERMINAL_API="http://127.0.0.1:5055"

# Platform / SaaS admin allowlist (in addition to account role ADMIN).
# Marketing contact form (/api/contact) also notifies these addresses.
# Comma-separated for multiple admins.
# ADMIN_EMAIL=you@example.com
# ADMIN_EMAILS=a@example.com,b@example.com

# Encrypt restaurant PayPal/Stripe secrets at rest (32-byte hex or any passphrase).
# Falls back to scrypt(NEXTAUTH_SECRET) when unset.
# CREDENTIALS_ENCRYPTION_KEY="64-char-hex-or-long-random-string"

PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
PAYPAL_CURRENCY="EUR"

# PayPal Commerce Platform (multiparty / connected merchants)
# Partner merchant ID: PayPal Business settings → Business information
PAYPAL_PARTNER_MERCHANT_ID="your_platform_paypal_merchant_id"
# BN code for PayPal-Partner-Attribution-Id header (partner dashboard)
PAYPAL_BN_CODE="your_bn_code"
# Webhook ID from PayPal Developer Dashboard → Webhooks (live + sandbox apps)
PAYPAL_WEBHOOK_ID="your_webhook_id"

# SMTP (transactional email — invites, password reset, contact form, welcome mail)
# Gmail setup:
#   1) Enable 2-Step Verification:      https://myaccount.google.com/security
#   2) Generate a 16-char App Password: https://myaccount.google.com/apppasswords
#   3) Paste the App Password into SMTP_PASSWORD (spaces are stripped automatically).
#   4) SMTP_FROM_EMAIL must match SMTP_USER or a verified "Send mail as" alias.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your.account@example.com"
SMTP_PASSWORD="xxxxxxxxxxxxxxxx"
SMTP_FROM_EMAIL="Restaurant <your.account@example.com>"

# Customer order display (/order-display): calendar "today" for filtering tickets
# (matches daily token numbers). IANA name, e.g. Europe/Dublin. Default UTC.
# ORDER_DISPLAY_TIMEZONE=Europe/Dublin

# --- Deploy / database (required on every new server) ---
# 1. Set DATABASE_URL in .env
# 2. npx prisma migrate deploy   (applies schema — run BEFORE seed)
# 3. npx prisma db seed          (demo restaurant + admin user)
# Or: npm run db:setup

# Subscription admin dates (platform billing UI). Naive datetime-local values are
# interpreted in this timezone. PayPal billing uses the same clock time in PAYPAL zone.
SUBSCRIPTION_ADMIN_TIMEZONE=Asia/Karachi
PAYPAL_BILLING_TIMEZONE=America/New_York
NEXT_PUBLIC_SUBSCRIPTION_ADMIN_TIMEZONE=Asia/Karachi
NEXT_PUBLIC_PAYPAL_BILLING_TIMEZONE=America/New_York
